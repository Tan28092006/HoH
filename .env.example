HOH_DATABASE_PATH=data/control-plane.db
# Start hoh-supervisor separately for bounded native worker execution.
HOH_WORKER_MODE=supervised
HOH_HOST=127.0.0.1
HOH_PORT=8765
HOH_LOCAL_MODE=1
HOH_SEED_DEMO=1

# Production only. Keep real values outside source control.
# HOH_MCP_TRANSPORT=streamable-http
# HOH_MCP_ALLOWED_HOSTS=hoh.example.com
# HOH_MCP_ALLOWED_ORIGINS=https://hoh.example.com
# HOH_ADMIN_TOKEN=replace-at-runtime
# HOH_AGENT_TOKENS_JSON={"runtime-token":{"agent_id":"dev-01","role":"developer","project_ids":["project-1"]}}
